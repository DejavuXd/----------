# Same-origin server endpoint. Leave empty until the real handler is configured.
VITE_CONTACT_ENDPOINT=
# Set to true only after approved privacy/consent documents are added and linked.
VITE_CONTACT_LEGAL_READY=false
# Public same-origin URLs of approved documents. Empty means submissions disabled.
VITE_PRIVACY_URL=
VITE_CONSENT_URL=
# Final public HTTPS URL; leave empty until the domain is confirmed.
SITE_URL=
# Existing counter ID only. Analytics is never loaded automatically.
VITE_METRIKA_ID=
