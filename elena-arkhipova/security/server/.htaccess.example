# TEMPLATE ONLY: Apache 2.4 + AllowOverride + mod_headers/mod_rewrite required.
# Generate hashes from the FINAL build with security/scripts/prepare-apache.mjs.
# Never copy this template verbatim. Do not deploy it on an nginx-only server.
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# After certificate + direct/proxy HTTPS detection are verified, enable:
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://YOUR-CANONICAL-DOMAIN%{REQUEST_URI} [R=308,L,NE]
# Never trust arbitrary X-Forwarded-Proto headers; ask REG.RU for its proxy setup.

# Deny hidden paths (except ACME), source directories and backup/config artifacts.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
RewriteRule ^(?:security|src|public|node_modules|vendor|qa)(?:/|$) - [F,L,NC]
<FilesMatch "(?i)(?:\.(?:env|ini|log|bak|old|orig|sql|sqlite(?:3)?(?:-(?:wal|shm|journal))?|map|pem|key|ya?ml|toml|lock|zip|tar|gz)(?:\..*)?$|^(?:composer|package)(?:-lock)?\.json$|^(?:App|config|smtp(?:\.example|\.local)?)\.php$|^vite\.config\.)">
  Require all denied
</FilesMatch>

Header always set X-Content-Type-Options "nosniff"
Header always unset X-Powered-By
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# Exact script hashes retain the existing inline bootstrap/preloader and JSON-LD.
# style unsafe-inline is needed by current style attributes / animation code.
Header always set Content-Security-Policy "default-src 'none'; script-src 'self' @@SCRIPT_HASHES@@; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
# HSTS intentionally disabled. After stable HTTPS, consider a short max-age first.
# Header always set Strict-Transport-Security "max-age=300"
# Do not add includeSubDomains/preload before all subdomains are ready.
